{
  "name": "qreader",
  "private": true,
  "version": "1.2.3",
  "description": "Web-based ebook reader supporting TXT, PDF, EPUB, MOBI, DOCX, Markdown",
  "author": "qiz7z",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/http-server.js",
    "server:proxy": "set TTS_PROXY=http://127.0.0.1:10809 && node server/http-server.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win --config",
    "electron:build:nsis": "npm run build && electron-builder --win nsis --config",
    "electron:build:portable": "npm run build && electron-builder --win portable --config"
  },
  "build": {
    "appId": "com.qreader.app",
    "productName": "QReader",
    "directories": {
      "output": "releases"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public/qreader-icon-transparent.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/qreader-icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QReader",
      "artifactName": "QReader-${version}-Setup.exe",
      "installerIcon": "public/qreader-icon.ico",
      "uninstallerIcon": "public/qreader-icon.ico"
    },
    "portable": {
      "artifactName": "QReader-${version}.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "dexie": "^4.4.2",
    "edge-tts-universal": "^1.4.0",
    "element-plus": "^2.14.0",
    "epubjs": "^0.3.93",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "canvas": "^3.2.3",
    "cors": "^2.8.6",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "express": "^5.2.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
